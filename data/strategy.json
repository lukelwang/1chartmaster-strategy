  "glossary": [
    {
      "term": "RS / RS Rating / 蓝点",
      "definition": "相对市场或基准的强弱；蓝点常用于作者图上标示相对强势新高。RS 与 RSI 不同，评分及蓝点算法未完整公开。"
    },
    {
      "term": "Pivot",
      "definition": "可交易的价格关口或反转触发。日线 pivot、开盘区间 pivot 与下跌后的 30 分钟反转 pivot 要按上下文区分。"
    },
    {
      "term": "DTL / DTR",
      "definition": "下降趋势线 / 下降趋势阻力。作者观察突破、回测与阻力转支撑。"
    },
    {
      "term": "S/R flip",
      "definition": "原先阻力被突破后，回测时转为支撑；仍须观察其能否守住。"
    },
    {
      "term": "8-week EMA",
      "definition": "周线的 8 周指数均线，是作者动能股回调的重要参考。"
    },
    {
      "term": "Squat",
      "definition": "强势股回退或横盘在均线 / 结构支撑附近，形成收紧的待触发状态；不是所有跌势都叫 squat。"
    },
    {
      "term": "Inside day / week",
      "definition": "当日 / 当周高低点处于前一周期高低点之内，用于观察波动收缩与较清楚的触发、失效区间。"
    },
    {
      "term": "VCP / HTF",
      "definition": "波动收缩形态 / 高紧旗形。作者会观察强动能之后的浅回调、收紧与量缩，但两者不能随意互换。"
    },
    {
      "term": "HVE / PEG",
      "definition": "历史最高成交量 / 财报后跳空。HVE 是作者图上重要标签，仍需结合事件发生在底部、整理或长上涨后的不同位置。"
    },
    {
      "term": "ORB",
      "definition": "开盘区间突破；本档案多头例子用开盘第一根 30 分钟 K 线高点作触发。"
    },
    {
      "term": "Chop / Trim / Core",
      "definition": "卖出部分、减仓与保留的核心仓位；作者用强势中的兑现来支付风险，再让剩余继续跟随。"
    },
    {
      "term": "R / Free trade",
      "definition": "R 是初始计划风险的计量；free trade 是已兑现利润覆盖剩余计划亏损的管理说法，结果仍取决于实际执行。"
    }
  ],
